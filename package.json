{
  "name": "siyuan-plugin-wengu",
  "version": "0.1.1",
  "description": "温故 (Wengu) — question drilling, wrong-answer review, and spaced repetition for SiYuan",
  "main": "dist/index.js",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --fix --cache",
    "dev": "run-p dev:kernel dev:app",
    "dev:app": "webpack --config webpack.config.js --mode development",
    "dev:kernel": "webpack --config webpack.kernel.config.js --mode development",
    "build": "run-s build:kernel build:app",
    "build:app": "webpack --config webpack.config.js --mode production",
    "build:kernel": "webpack --config webpack.kernel.config.js --mode production"
  },
  "keywords": [
    "siyuan",
    "quiz",
    "flashcard",
    "spaced-repetition"
  ],
  "author": "kuangdongksk",
  "license": "MIT",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "esbuild-loader": "^4.4.3",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "mini-css-extract-plugin": "^2.10.2",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "sass": "^1.100.0",
    "sass-loader": "^17.0.0",
    "siyuan": "1.2.4",
    "svelte": "^5.56.10",
    "svelte-loader": "^3.2.4",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3",
    "zip-webpack-plugin": "^4.0.3"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "fflate": "^0.8.3"
  }
}
